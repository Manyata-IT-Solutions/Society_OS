# ==============================================================================
# Community OS - Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# Copy this file to .env and adjust values for your local development environment.

# ------------------------------------------------------------------------------
# Core Platform
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_NAME=CommunityOS
APP_VERSION=0.1.0
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_dev_password
DATABASE_NAME=community_os_dev
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5434/community_os_dev?schema=public&connection_limit=20&pool_timeout=10

# ------------------------------------------------------------------------------
# Redis Cache & Queues
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password
REDIS_URL=redis://:redis_dev_password@localhost:6379/0

# ------------------------------------------------------------------------------
# Security & JWT (Local dev placeholders)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_min32chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_min32chars!
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Observability & Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true
SWAGGER_ENABLED=true

# ------------------------------------------------------------------------------
# Admin Web App (Client)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=Community OS
NEXT_PUBLIC_APP_VERSION=0.1.0
