{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^(\\./.*)\\.js$": "$1",
    "^(\\.\\./.*)\\.js$": "$1"
  },
  "testEnvironment": "node",
  "testTimeout": 300000,
  "maxWorkers": 1
}
