  accountNumber      String           @map("account_number") @db.VarChar(50)
  currency           String           @default("INR") @db.VarChar(10)
  status             EntityStatus     @default(ACTIVE)
  currentPayable     Decimal          @default(0) @map("current_payable") @db.Decimal(14, 4)
  advanceBalance     Decimal          @default(0) @map("advance_balance") @db.Decimal(14, 4)
  creditBalance      Decimal          @default(0) @map("credit_balance") @db.Decimal(14, 4)
  lastInvoiceDate    DateTime?        @map("last_invoice_date") @db.Date
  lastPaymentDate    DateTime?        @map("last_payment_date") @db.Date
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
