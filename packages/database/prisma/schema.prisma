model UtilityService {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  communityId    String        @map("community_id") @db.Uuid
  code           String        @db.VarChar(50)
  name           String        @db.VarChar(255)
  utilityType    UtilityType   @map("utility_type")
  unitOfMeasure  String        @map("unit_of_measure") @db.VarChar(50)
  status         UtilityStatus @default(ACTIVE)
  billingEnabled Boolean       @default(true) @map("billing_enabled")
  timezone       String        @default("UTC") @db.VarChar(50)
  metadata       Json?         @db.JsonB
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community      Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  sources        UtilitySupplySource[]
  meters         UtilityMeter[]
  tariffPlans    UtilityTariffPlan[]
  outages        UtilityOutage[]
  anomalies      UtilityAnomaly[]

  @@unique([communityId, code])
  @@index([communityId, utilityType, status])
  @@map("utility_services")
}

model UtilitySupplySource {
  id               String            @id @default(uuid()) @db.Uuid
  utilityServiceId String            @map("utility_service_id") @db.Uuid
  sourceType       UtilitySourceType @map("source_type")
  code             String            @db.VarChar(50)
  name             String            @db.VarChar(255)
  assetId          String?           @map("asset_id") @db.Uuid
  vendorId         String?           @map("vendor_id") @db.Uuid
  capacity         Decimal?          @db.Decimal(14, 4)
  capacityUom      String?           @map("capacity_uom") @db.VarChar(50)
  status           String            @default("ACTIVE") @db.VarChar(50)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  utilityService UtilityService @relation(fields: [utilityServiceId], references: [id], onDelete: Cascade)
  asset          Asset?         @relation(fields: [assetId], references: [id])

  @@unique([utilityServiceId, code])
  @@map("utility_supply_sources")
}

model UtilityStorage {
  id             String   @id @default(uuid()) @db.Uuid
  communityId    String   @map("community_id") @db.Uuid
  storageType    String   @map("storage_type") @db.VarChar(50)
  name           String   @db.VarChar(255)
  capacity       Decimal  @db.Decimal(14, 4)
  usableCapacity Decimal? @map("usable_capacity") @db.Decimal(14, 4)
  uom            String   @db.VarChar(50)
  currentLevel   Decimal? @map("current_level") @db.Decimal(14, 4)
  assetId        String?  @map("asset_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("utility_storages")
}

model UtilityMeter {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  communityId      String             @map("community_id") @db.Uuid
  utilityServiceId String             @map("utility_service_id") @db.Uuid
  meterNumber      String             @unique @map("meter_number") @db.VarChar(100)
  serialNumber     String?            @map("serial_number") @db.VarChar(100)
  meterType        UtilityMeterType   @default(SUB_METER) @map("meter_type")
  measurementType  MeasurementType    @default(ENERGY) @map("measurement_type")
  uom              String             @db.VarChar(50)
  status           UtilityMeterStatus @default(ACTIVE)
  manufacturer     String?            @db.VarChar(100)
  model            String?            @db.VarChar(100)
  multiplier       Decimal            @default(1.0) @db.Decimal(8, 4)
  decimalPlaces    Int                @default(2) @map("decimal_places")
  rolloverValue    Decimal?           @map("rollover_value") @db.Decimal(14, 4)
  parentMeterId    String?            @map("parent_meter_id") @db.Uuid
  assetId          String?            @map("asset_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community           Community                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  utilityService      UtilityService           @relation(fields: [utilityServiceId], references: [id], onDelete: Cascade)
  asset               Asset?                   @relation(fields: [assetId], references: [id])
  parentMeter         UtilityMeter?            @relation("MeterHierarchy", fields: [parentMeterId], references: [id])
  childMeters         UtilityMeter[]           @relation("MeterHierarchy")
  assignments         UtilityMeterAssignment[]
  readings            UtilityMeterReading[]
  consumptionRecords  UtilityConsumptionRecord[]
  chargeCalculations  UtilityChargeCalculation[]
  oldReplacements     MeterReplacementRecord[] @relation("OldMeterReplacements")
  newReplacements     MeterReplacementRecord[] @relation("NewMeterReplacements")
  calibrations        MeterCalibrationRecord[]
  anomalies           UtilityAnomaly[]

  @@index([communityId, utilityServiceId, status])
  @@map("utility_meters")
}

model UtilityMeterAssignment {
  id                   String                     @id @default(uuid()) @db.Uuid
  meterId              String                     @map("meter_id") @db.Uuid
  targetType           MeterAssignmentTargetType  @map("target_type")
  targetId             String                     @map("target_id") @db.Uuid
  effectiveFrom        DateTime                   @map("effective_from") @db.Timestamptz(6)
  effectiveUntil       DateTime?                  @map("effective_until") @db.Timestamptz(6)
  allocationPercentage Decimal                    @default(100.0) @map("allocation_percentage") @db.Decimal(5, 2)
  unitId               String?                    @map("unit_id") @db.Uuid
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  meter UtilityMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)
  unit  Unit?        @relation(fields: [unitId], references: [id])

  @@index([meterId, effectiveFrom, effectiveUntil])
  @@index([targetType, targetId])
  @@map("utility_meter_assignments")
}

model MeterInstallationRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  meterId            String   @map("meter_id") @db.Uuid
  installedAt        DateTime @map("installed_at") @db.Timestamptz(6)
  location           String   @db.VarChar(255)
  openingReading     Decimal  @map("opening_reading") @db.Decimal(14, 4)
  installerName      String?  @map("installer_name") @db.VarChar(255)
  evidenceDocumentId String?  @map("evidence_document_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("meter_installation_records")
}

model MeterCalibrationRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  meterId            String   @map("meter_id") @db.Uuid
  calibratedAt       DateTime @map("calibrated_at") @db.Timestamptz(6)
  calibrationResult  String   @map("calibration_result") @db.VarChar(100)
  newMultiplier      Decimal? @map("new_multiplier") @db.Decimal(8, 4)
  nextDueDate        DateTime? @map("next_due_date") @db.Timestamptz(6)
  evidenceDocumentId String?  @map("evidence_document_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  meter UtilityMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@map("meter_calibration_records")
}

model MeterReplacementRecord {
  id                     String   @id @default(uuid()) @db.Uuid
  oldMeterId             String   @map("old_meter_id") @db.Uuid
  newMeterId             String   @map("new_meter_id") @db.Uuid
  effectiveAt            DateTime @map("effective_at") @db.Timestamptz(6)
  oldMeterFinalReading   Decimal  @map("old_meter_final_reading") @db.Decimal(14, 4)
  newMeterOpeningReading Decimal  @map("new_meter_opening_reading") @db.Decimal(14, 4)
  reason                 String?  @db.Text
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  oldMeter UtilityMeter @relation("OldMeterReplacements", fields: [oldMeterId], references: [id])
  newMeter UtilityMeter @relation("NewMeterReplacements", fields: [newMeterId], references: [id])

  @@map("meter_replacement_records")
}

model MeterReadingRoute {
  id          String   @id @default(uuid()) @db.Uuid
  communityId String   @map("community_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  meterIds    String[] @map("meter_ids")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("meter_reading_routes")
}

model MeterReadingSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  communityId String   @map("community_id") @db.Uuid
  routeId     String?  @map("route_id") @db.Uuid
  frequency   String   @db.VarChar(50)
  dayOfMonth  Int?     @map("day_of_month")
  dueTime     String?  @map("due_time") @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("meter_reading_schedules")
}

model UtilityMeterReading {
  id                 String              @id @default(uuid()) @db.Uuid
  meterId            String              @map("meter_id") @db.Uuid
  readingAt          DateTime            @map("reading_at") @db.Timestamptz(6)
  value              Decimal             @db.Decimal(14, 4)
  uom                String              @db.VarChar(50)
  readingType        MeterReadingType    @default(ACTUAL) @map("reading_type")
  source             MeterReadingSource  @default(MANUAL)
  status             MeterReadingStatus  @default(APPROVED)
  quality            MeterReadingQuality @default(GOOD)
  multiplierSnapshot Decimal             @default(1.0) @map("multiplier_snapshot") @db.Decimal(8, 4)
  submittedById      String?             @map("submitted_by_id") @db.Uuid
  evidenceDocumentId String?             @map("evidence_document_id") @db.Uuid
  notes              String?             @db.Text
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  meter                  UtilityMeter               @relation(fields: [meterId], references: [id], onDelete: Cascade)
  evidenceDocument       Document?                  @relation(fields: [evidenceDocumentId], references: [id])
  openingForConsumptions UtilityConsumptionRecord[] @relation("OpeningReadings")
  closingForConsumptions UtilityConsumptionRecord[] @relation("ClosingReadings")

  @@index([meterId, readingAt])
  @@map("utility_meter_readings")
}

model UtilityConsumptionRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  meterId            String   @map("meter_id") @db.Uuid
  periodStart        DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd          DateTime @map("period_end") @db.Timestamptz(6)
  openingReadingId   String?  @map("opening_reading_id") @db.Uuid
  closingReadingId   String?  @map("closing_reading_id") @db.Uuid
  rawDelta           Decimal  @map("raw_delta") @db.Decimal(14, 4)
  multiplierSnapshot Decimal  @default(1.0) @map("multiplier_snapshot") @db.Decimal(8, 4)
  consumption        Decimal  @db.Decimal(14, 4)
  uom                String   @db.VarChar(50)
  calculationStatus  String   @default("VALID") @map("calculation_status") @db.VarChar(50)
  calculationVersion Int      @default(1) @map("calculation_version")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  meter              UtilityMeter                @relation(fields: [meterId], references: [id], onDelete: Cascade)
  openingReading     UtilityMeterReading?        @relation("OpeningReadings", fields: [openingReadingId], references: [id])
  closingReading     UtilityMeterReading?        @relation("ClosingReadings", fields: [closingReadingId], references: [id])
  adjustments        UtilityConsumptionAdjustment[]
  chargeCalculations UtilityChargeCalculation[]

  @@index([meterId, periodStart, periodEnd])
  @@map("utility_consumption_records")
}

model UtilityConsumptionAdjustment {
  id                  String   @id @default(uuid()) @db.Uuid
  consumptionRecordId String   @map("consumption_record_id") @db.Uuid
  deltaConsumption    Decimal  @map("delta_consumption") @db.Decimal(14, 4)
  reason              String   @db.Text
  approvedById        String?  @map("approved_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  consumptionRecord UtilityConsumptionRecord @relation(fields: [consumptionRecordId], references: [id], onDelete: Cascade)

  @@map("utility_consumption_adjustments")
}

model UtilityTariffPlan {
  id               String            @id @default(uuid()) @db.Uuid
  utilityServiceId String            @map("utility_service_id") @db.Uuid
  name             String            @db.VarChar(255)
  code             String            @db.VarChar(50)
  effectiveFrom    DateTime          @map("effective_from") @db.Timestamptz(6)
  effectiveUntil   DateTime?         @map("effective_until") @db.Timestamptz(6)
  currency         String            @default("INR") @db.VarChar(10)
  billingUom       String            @map("billing_uom") @db.VarChar(50)
  status           TariffStatus      @default(ACTIVE)
  versionNumber    Int               @default(1) @map("version_number")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  utilityService     UtilityService             @relation(fields: [utilityServiceId], references: [id], onDelete: Cascade)
  components         TariffComponent[]
  chargeCalculations UtilityChargeCalculation[]

  @@unique([utilityServiceId, code, versionNumber])
  @@map("utility_tariff_plans")
}

model TariffComponent {
  id            String              @id @default(uuid()) @db.Uuid
  tariffPlanId  String              @map("tariff_plan_id") @db.Uuid
  componentType TariffComponentType @map("component_type")
  name          String              @db.VarChar(255)
  fixedAmount   Decimal?            @map("fixed_amount") @db.Decimal(12, 2)
  ratePerUnit   Decimal?            @map("rate_per_unit") @db.Decimal(12, 4)
  minimumAmount Decimal?            @map("minimum_amount") @db.Decimal(12, 2)
