  taxAmount             Decimal  @default(0) @map("tax_amount") @db.Decimal(14, 4)
  freightAmount         Decimal  @default(0) @map("freight_amount") @db.Decimal(14, 4)
  otherCharges          Decimal  @default(0) @map("other_charges") @db.Decimal(14, 4)
