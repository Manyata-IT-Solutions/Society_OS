model SecurityGate {
  id                     String              @id @default(uuid()) @db.Uuid
  organizationId         String              @map("organization_id") @db.Uuid
  communityId            String              @map("community_id") @db.Uuid
  code                   String              @db.VarChar(50)
  name                   String              @db.VarChar(150)
  gateType               SecurityGateType    @default(MAIN) @map("gate_type")
  directionPolicy        GateDirectionPolicy @default(ENTRY_AND_EXIT) @map("direction_policy")
  status                 SecurityGateStatus  @default(ACTIVE)
  locationDescription    String?             @map("location_description") @db.Text
  supportsVehicleEntry   Boolean             @default(true) @map("supports_vehicle_entry")
  supportsPedestrianEntry Boolean            @default(true) @map("supports_pedestrian_entry")
  supportsDelivery       Boolean             @default(true) @map("supports_delivery")
  supportsContractorEntry Boolean            @default(true) @map("supports_contractor_entry")
  createdById            String?             @map("created_by_id") @db.Uuid
  version                Int                 @default(1)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community              Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy              User?               @relation("SecurityGateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  posts                  SecurityPost[]
  entryVisits            Visit[]             @relation("VisitEntryGate")
  exitVisits             Visit[]             @relation("VisitExitGate")
  accessEvents           GateAccessEvent[]
  activeVisits           ActiveVisit[]
  devices                GateDevice[]
  shifts                 SecurityShift[]
  overrideLogs           SecurityOverrideLog[]

  @@unique([communityId, code])
  @@index([organizationId])
  @@index([communityId, status])
  @@map("security_gates")
}

model SecurityPost {
  id          String             @id @default(uuid()) @db.Uuid
  gateId      String             @map("gate_id") @db.Uuid
  code        String             @db.VarChar(50)
  name        String             @db.VarChar(100)
  description String?            @db.Text
  status      SecurityGateStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  gate         SecurityGate      @relation(fields: [gateId], references: [id], onDelete: Cascade)
  accessEvents GateAccessEvent[]

  @@unique([gateId, code])
  @@map("security_posts")
}

model AccessZone {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  communityId    String       @map("community_id") @db.Uuid
  name           String       @db.VarChar(100)
  code           String       @db.VarChar(50)
  zoneType       String       @default("GENERAL") @map("zone_type") @db.VarChar(50)
  description    String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  community      Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, code])
  @@map("access_zones")
}

model VisitorProfile {
  id                     String           @id @default(uuid()) @db.Uuid
  organizationId         String           @map("organization_id") @db.Uuid
  communityId            String           @map("community_id") @db.Uuid
  name                   String           @db.VarChar(150)
  phone                  String?          @db.VarChar(30)
  email                  String?          @db.VarChar(255)
  phoneHash              String?          @map("phone_hash") @db.VarChar(64)
  photoDocumentId        String?          @map("photo_document_id") @db.Uuid
  identityDocumentType   String?          @map("identity_document_type") @db.VarChar(50)
  maskedIdentityDocNumber String?         @map("masked_identity_doc_number") @db.VarChar(50)
  vehicleNumber          String?          @map("vehicle_number") @db.VarChar(30)
  normalizedVehicleNumber String?         @map("normalized_vehicle_number") @db.VarChar(30)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

