  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountingEntity AccountingEntity @relation(fields: [accountingEntityId], references: [id], onDelete: Cascade)
  vendor           Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  ledgerEntries    VendorLedgerEntry[]
  supplierInvoices SupplierInvoice[]
  creditNotes      SupplierCreditNote[]
  payments         VendorPayment[]
  advances         VendorAdvance[]

  @@unique([accountingEntityId, vendorId])
  @@unique([accountingEntityId, accountNumber])
  @@index([vendorId])
  @@map("vendor_accounts")
}

