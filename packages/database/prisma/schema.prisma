model ParkingViolation {
  id                  String                   @id @default(uuid()) @db.Uuid
  organizationId      String                   @map("organization_id") @db.Uuid
  communityId         String                   @map("community_id") @db.Uuid
  violationNumber     String                   @map("violation_number") @db.VarChar(50)
  vehicleId           String?                  @map("vehicle_id") @db.Uuid
  parkingSlotId       String?                  @map("parking_slot_id") @db.Uuid
  parkingAreaId       String?                  @map("parking_area_id") @db.Uuid
  vehicleNumber       String                   @map("vehicle_number") @db.VarChar(30)
  violationType       String                   @default("UNAUTHORIZED_PARKING") @map("violation_type") @db.VarChar(50)
  occurredAt          DateTime                 @default(now()) @map("occurred_at") @db.Timestamptz(6)
  reportedById        String?                  @map("reported_by_id") @db.Uuid
  status              String                   @default("OPEN") @db.VarChar(30)
  severity            String                   @default("MEDIUM") @db.VarChar(30)
  description         String                   @db.Text
  evidenceDocumentId  String?                  @map("evidence_document_id") @db.Uuid
  penaltyChargeAmount Decimal?                 @map("penalty_charge_amount") @db.Decimal(10, 2)
  penaltyBilled       Boolean                  @default(false) @map("penalty_billed")
  resolution          String?                  @db.Text
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  version             Int                      @default(1)

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community           Community                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  vehicle             Vehicle?                 @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  parkingSlot         ParkingSlot?             @relation(fields: [parkingSlotId], references: [id], onDelete: SetNull)
  parkingArea         ParkingArea?             @relation(fields: [parkingAreaId], references: [id], onDelete: SetNull)
  reportedBy          User?                    @relation(fields: [reportedById], references: [id], onDelete: SetNull)
  evidenceDocument    Document?                @relation(fields: [evidenceDocumentId], references: [id], onDelete: SetNull)
  appeals             ParkingViolationAppeal[]

  @@index([communityId, status])
  @@index([vehicleId])
  @@index([violationNumber])
  @@map("parking_violations")
}

model ParkingViolationAppeal {
