generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum ScopeType {
  PLATFORM
  ORGANIZATION
  COMMUNITY
  OWN
}

enum AssignmentStatus {
  ACTIVE
  REVOKED
}

enum BuildingType {
  TOWER
  BLOCK
  WING
  BUILDING
  VILLA_CLUSTER
  ROW_HOUSE_BLOCK
  OTHER
}

enum BuildingStatus {
  PLANNED
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum FloorStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UnitType {
  APARTMENT
  VILLA
  PENTHOUSE
  STUDIO
  DUPLEX
  ROW_HOUSE
  OTHER
}

enum UnitStatus {
  PLANNED
  UNDER_CONSTRUCTION
  READY
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AreaUnit {
  SQFT
  SQM
}

enum PropertyImportStatus {
  PENDING
  VALIDATING
  READY
  PROCESSING
  COMPLETED
  FAILED
}

enum ResidentStatus {
  PENDING
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum HouseholdStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum HouseholdRelationshipType {
  SELF
  SPOUSE
  CHILD
  PARENT
  SIBLING
  RELATIVE
  DOMESTIC_STAFF
  OTHER
}

enum HouseholdMemberStatus {
  ACTIVE
  INACTIVE
  LEFT
}

enum OwnershipType {
  SOLE
  JOINT
  CORPORATE
  DEVELOPER
  TRUST
  OTHER
}

enum OwnershipStatus {
  ACTIVE
  TRANSFERRED
  ENDED
  CANCELLED
}

enum TenancyStatus {
  PLANNED
  ACTIVE
  ENDED
  CANCELLED
}

enum OccupancyType {
  OWNER_OCCUPIED
  TENANT_OCCUPIED
  FAMILY_OCCUPIED
  OTHER
}

enum OccupancyStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum ResidentImportStatus {
  PENDING
  VALIDATING
  READY
  PROCESSING
  COMPLETED
  FAILED
}

enum AuditActorType {
  USER
  SYSTEM
  SERVICE
  BACKGROUND_JOB
  PLATFORM_OPERATOR
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

enum AuditClassification {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum AuditRetentionCategory {
  SECURITY
  FINANCIAL
  GOVERNANCE
  OPERATIONAL
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
  WHATSAPP
  WEBHOOK
}

enum NotificationCategory {
  SYSTEM
  SECURITY
  ACCOUNT
  RESIDENT
  PROPERTY
  GOVERNANCE
  FINANCE
  MAINTENANCE
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum NotificationStatus {
  DRAFT
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  PARTIALLY_DELIVERED
  FAILED
  CANCELLED
}

enum NotificationDeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
  SKIPPED
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  QUARANTINED
  DELETED
}

enum DocumentClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum DocumentCategory {
  POLICY
  LEGAL
  GOVERNANCE
  RESIDENT
  PROPERTY
  GENERAL
  FINANCIAL
  MAINTENANCE
}

enum DocumentVersionStatus {
  PENDING_SCAN
  ACTIVE
  QUARANTINED
  ARCHIVED
}

enum DocumentRelationshipType {
  ATTACHMENT
  PRIMARY_DOCUMENT
  PROOF
  CONTRACT
  INVOICE_COPY
  PHOTO_EVIDENCE
}

model Organization {
  projects             Project[]
  budgets              Budget[]
  budgetTemplates      BudgetTemplate[]
  budgetAssumptions    BudgetAssumption[]
  capexInitiatives     CapexInitiative[]
  id              String       @id @default(uuid()) @db.Uuid
  name            String       @db.VarChar(255)
  slug            String       @unique @db.VarChar(100)
  legalName       String?      @map("legal_name") @db.VarChar(255)
  status          EntityStatus @default(ACTIVE)
  defaultTimezone String       @default("UTC") @map("default_timezone") @db.VarChar(50)
  defaultLocale   String       @default("en-US") @map("default_locale") @db.VarChar(20)
  defaultCurrency String       @default("USD") @map("default_currency") @db.VarChar(3)
  settings        Json         @default("{}") @db.JsonB
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolios             Portfolio[]
  communities            Community[]
  sections               CommunitySection[]
  buildings              Building[]
  floors                 Floor[]
  units                  Unit[]
  importJobs             PropertyImportJob[]
  residents              Resident[]
  households             Household[]
  ownerships             UnitOwnership[]
  tenancies              UnitTenancy[]
  occupancies            UnitOccupancy[]
  residentImportJobs     ResidentImportJob[]
  memberships            TenantMembership[]
  unitOfMeasures         UnitOfMeasure[]
  inventoryItems         InventoryItem[]
  inventoryCategories    InventoryCategory[]
  inventoryStores        InventoryStore[]
  stockLedgerEntries     StockLedgerEntry[]
  inventoryReceipts      InventoryReceipt[]
  inventoryIssues        InventoryIssue[]
  inventoryReturns       InventoryReturn[]
  stockTransfers         StockTransfer[]
  stockAdjustments       StockAdjustment[]
  stockCounts            StockCount[]
  inventorySequences     InventorySequence[]
  inventoryImportJobs    InventoryImportJob[]
  vendors                Vendor[]
  purchaseRequisitions   PurchaseRequisition[]
  rfqs                   RequestForQuotation[]
  sourcingAwards         SourcingAward[]
  purchaseOrders         PurchaseOrder[]
  goodsReceiptNotes      GoodsReceiptNote[]
  serviceReceiptNotes    ServiceReceiptNote[]
  roles                  Role[]
  auditLogs              AuditLog[]
  auditRecords           AuditRecord[]
  notificationTemplates  NotificationTemplate[]
  notifications          Notification[]
  documents              Document[]
  documentLinks          DocumentLink[]
  configurationOverrides ConfigurationOverride[]
  featureOverrides       FeatureOverride[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]
  workflowDefinitions    WorkflowDefinition[]
  workflowInstances      WorkflowInstance[]
  ruleDefinitions        RuleDefinition[]
  approvalPolicies       ApprovalPolicyDefinition[]
  approvalInstances      ApprovalInstance[]
  businessCalendars      BusinessCalendar[]
  slaPolicies            SlaPolicyDefinition[]
  slaInstances           SlaInstance[]
  ticketCategories       TicketCategory[]
  helpdeskTeams          HelpdeskTeam[]
  tickets                Ticket[]
  ticketSequences        TicketSequence[]
  facilityCategories     FacilityWorkCategory[]
  workOrders             WorkOrder[]
  workOrderSequences     WorkOrderSequence[]
  checklistTemplates     FacilityChecklistTemplate[]
  maintenancePlans       MaintenancePlan[]
  assetCategories        AssetCategory[]
  assetModels            AssetModel[]
  assets                 Asset[]
  assetServiceContracts  AssetServiceContract[]
  assetImportJobs        AssetImportJob[]
  accountingEntities     AccountingEntity[]
  billableAccounts       BillableAccount[]
  visitorInvitations       VisitorInvitation[]
  chargeDefinitions      ChargeDefinition[]
  invoices               Invoice[]
  payments               Payment[]
  vendorAccounts         VendorAccount[]
  supplierInvoices       SupplierInvoice[]
  supplierCreditNotes    SupplierCreditNote[]
  paymentTerms           PaymentTerms[]
  matchingTolerancePolicies MatchingTolerancePolicy[]
  paymentProposals       PaymentProposal[]
  paymentRuns            PaymentRun[]
  vendorPayments         VendorPayment[]
  vendorAdvances         VendorAdvance[]

  securityGates            SecurityGate[]
  visitorProfiles          VisitorProfile[]
  accessPasses             AccessPass[]
  securityVisits           Visit[]
  gateAccessEvents         GateAccessEvent[]
  activeVisits             ActiveVisit[]
  contractorAuthorizations ContractorAccessAuthorization[]
  securityVehicles         SecurityVehicle[]
  vehicles                 Vehicle[]
  parkingAreas             ParkingArea[]
  parkingSlots             ParkingSlot[]
  parkingRights            ParkingRight[]
  parkingAllocations       ParkingAllocation[]
  amenities                Amenity[]
  amenityBookings          AmenityBooking[]
  workers                  Worker[]
  workforceDepartments     WorkforceDepartment[]
  workforceJobRoles        WorkforceJobRole[]
  workforceSkills          WorkforceSkill[]
  shiftTemplates           ShiftTemplate[]
  workforceRosters         WorkforceRoster[]
  attendanceSessions       AttendanceSession[]
  leaveRequests            LeaveRequest[]
  overtimeRecords          OvertimeRecord[]
  workforceTimesheets      WorkforceTimesheet[]
  workforceDeployments     WorkforceDeployment[]
  workforceTasks           WorkforceTask[]
  attendanceDevices        AttendanceDevice[]
  governanceCommittees     GovernanceCommittee[]
  committeePositions       CommitteePosition[]
  governanceMeetings       GovernanceMeeting[]
  quorumPolicies           QuorumPolicy[]
  proxyAuthorizations      GovernanceProxyAuthorization[]
  governancePolls          GovernancePoll[]
  governanceActionItems    GovernanceActionItem[]
  governanceNotices        GovernanceNotice[]
  governancePolicies       GovernancePolicy[]
  parkingPermits           ParkingPermit[]
  parkingOccupancySessions ParkingOccupancySession[]
  evChargingSessions       EVChargingSession[]
  parkingViolations        ParkingViolation[]
  watchlistEntries         WatchlistEntry[]
  gateDevices              GateDevice[]
  securityOverrideLogs     SecurityOverrideLog[]
