model AccountingEntity {
  budgets                Budget[]
  budgetAssumptions      BudgetAssumption[]
  forecasts              Forecast[]
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  communityId    String?                @map("community_id") @db.Uuid
  code           String                 @db.VarChar(50)
  name           String                 @db.VarChar(255)
  legalName      String                 @map("legal_name") @db.VarChar(255)
  countryCode    String                 @default("IND") @map("country_code") @db.VarChar(3)
  baseCurrency   String                 @default("INR") @map("base_currency") @db.VarChar(10)
  timezone       String                 @default("Asia/Kolkata") @db.VarChar(50)
  status         AccountingEntityStatus @default(ACTIVE)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int                    @default(1)

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community        Community?              @relation(fields: [communityId], references: [id], onDelete: SetNull)
  fiscalCalendars  FiscalCalendar[]
  fiscalYears      FiscalYear[]
  accounts         LedgerAccount[]
  accountMappings  AccountMapping[]
  costCenters      CostCenter[]
  funds            Fund[]
  journalEntries   JournalEntry[]
  ledgerEntries    GeneralLedgerEntry[]
  accountBalances  AccountBalance[]
  bankAccounts     BankAccount[]
  journalTemplates JournalTemplate[]
  integrityLogs    FinancialIntegrityLog[]
  vendorAccounts   VendorAccount[]
  supplierInvoices SupplierInvoice[]
  supplierCreditNotes SupplierCreditNote[]
  paymentProposals PaymentProposal[]
  paymentRuns      PaymentRun[]
  vendorPayments   VendorPayment[]
  vendorAdvances   VendorAdvance[]

  @@unique([organizationId, code])
  @@index([organizationId, communityId])
  @@index([status])
  @@map("accounting_entities")
}

model FiscalCalendar {
  id                 String   @id @default(uuid()) @db.Uuid
  accountingEntityId String   @map("accounting_entity_id") @db.Uuid
  name               String   @db.VarChar(100)
  fiscalStartMonth   Int      @default(4) @map("fiscal_start_month")
  fiscalStartDay     Int      @default(1) @map("fiscal_start_day")
  isDefault          Boolean  @default(true) @map("is_default")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accountingEntity AccountingEntity @relation(fields: [accountingEntityId], references: [id], onDelete: Cascade)
  fiscalYears      FiscalYear[]

  @@index([accountingEntityId])
  @@map("fiscal_calendars")
}

model FiscalYear {
  budgets              Budget[]
  fundPlans            FundPlan[]
  forecasts            Forecast[]
  budgetAssumptions    BudgetAssumption[]
  id                 String           @id @default(uuid()) @db.Uuid
  accountingEntityId String           @map("accounting_entity_id") @db.Uuid
  fiscalCalendarId   String           @map("fiscal_calendar_id") @db.Uuid
  name               String           @db.VarChar(50)
  startDate          DateTime         @map("start_date") @db.Date
  endDate            DateTime         @map("end_date") @db.Date
  status             FiscalYearStatus @default(OPEN)
  closedAt           DateTime?        @map("closed_at") @db.Timestamptz(6)
  closedById         String?          @map("closed_by_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int              @default(1)

  accountingEntity AccountingEntity     @relation(fields: [accountingEntityId], references: [id], onDelete: Cascade)
  fiscalCalendar   FiscalCalendar       @relation(fields: [fiscalCalendarId], references: [id], onDelete: Cascade)
