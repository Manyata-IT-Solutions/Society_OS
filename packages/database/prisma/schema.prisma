  discountTotal           Decimal                   @default(0) @map("discount_total") @db.Decimal(14, 4)
  taxTotal                Decimal                   @default(0) @map("tax_total") @db.Decimal(14, 4)
  freightTotal            Decimal                   @default(0) @map("freight_total") @db.Decimal(14, 4)
  otherCharges            Decimal                   @default(0) @map("other_charges") @db.Decimal(14, 4)
  roundingAmount          Decimal                   @default(0) @map("rounding_amount") @db.Decimal(14, 4)
  grandTotal              Decimal                   @default(0) @map("grand_total") @db.Decimal(14, 4)
  paidAmount              Decimal                   @default(0) @map("paid_amount") @db.Decimal(14, 4)
  outstandingAmount       Decimal                   @default(0) @map("outstanding_amount") @db.Decimal(14, 4)
  allocatedCreditAmount   Decimal                   @default(0) @map("allocated_credit_amount") @db.Decimal(14, 4)
  allocatedAdvanceAmount  Decimal                   @default(0) @map("allocated_advance_amount") @db.Decimal(14, 4)
  paymentTermsId          String?                   @map("payment_terms_id") @db.Uuid
  workflowInstanceId      String?                   @map("workflow_instance_id") @db.Uuid
  approvalRequestId       String?                   @map("approval_request_id") @db.Uuid
  documentId              String?                   @map("document_id") @db.Uuid
  postingJournalId        String?                   @map("posting_journal_id") @db.Uuid
  isOnHold                Boolean                   @default(false) @map("is_on_hold")
  holdReason              HoldReason?               @map("hold_reason")
  holdNotes               String?                   @map("hold_notes") @db.Text
  holdAt                  DateTime?                 @map("hold_at") @db.Timestamptz(6)
  holdById                String?                   @map("hold_by_id") @db.Uuid
  createdById             String?                   @map("created_by_id") @db.Uuid
  approvedById            String?                   @map("approved_by_id") @db.Uuid
  approvedAt              DateTime?                 @map("approved_at") @db.Timestamptz(6)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                 Int                       @default(1)

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountingEntity AccountingEntity @relation(fields: [accountingEntityId], references: [id], onDelete: Cascade)
  community        Community?       @relation(fields: [communityId], references: [id], onDelete: SetNull)
  vendor           Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorAccount    VendorAccount    @relation(fields: [vendorAccountId], references: [id], onDelete: Cascade)
  purchaseOrder    PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  document         Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  postingJournal   JournalEntry?    @relation(fields: [postingJournalId], references: [id], onDelete: SetNull)
  paymentTerms     PaymentTerms?    @relation(fields: [paymentTermsId], references: [id], onDelete: SetNull)

  lines                    SupplierInvoiceLine[]
  matchSnapshots           MatchSnapshot[]
  matchExceptions          MatchException[]
  creditNotes              SupplierCreditNote[]
  creditNoteAllocations    SupplierCreditNoteAllocation[]
  paymentAllocations       VendorPaymentAllocation[]
  advanceAllocations       VendorAdvanceAllocation[]
  proposalLines            PaymentProposalLine[]

  @@unique([accountingEntityId, vendorId, normalizedInvoiceNumber])
  @@unique([organizationId, internalInvoiceNumber])
  @@index([accountingEntityId, status, dueDate])
  @@index([purchaseOrderId])
  @@index([matchingStatus])
  @@index([outstandingAmount])
  @@map("supplier_invoices")
}

model SupplierInvoiceLine {
