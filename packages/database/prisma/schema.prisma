model Amenity {
  id                String                    @id @default(uuid()) @db.Uuid
  organizationId    String                    @map("organization_id") @db.Uuid
  communityId       String                    @map("community_id") @db.Uuid
  code              String                    @map("code") @db.VarChar(50)
  name              String                    @map("name") @db.VarChar(150)
  description       String?                   @db.Text
  category          String                    @default("SPORTS") @map("category") @db.VarChar(50)
  status            String                    @default("ACTIVE") @db.VarChar(30)
  bookingMode       String                    @default("INSTANT") @map("booking_mode") @db.VarChar(30)
  capacity          Int                       @default(1)
  requiresBooking   Boolean                   @default(true) @map("requires_booking")
  requiresApproval  Boolean                   @default(false) @map("requires_approval")
  guestAllowed      Boolean                   @default(true) @map("guest_allowed")
  isPaid            Boolean                   @default(false) @map("is_paid")
  locationReference String?                   @map("location_reference") @db.VarChar(100)
  coverDocumentId   String?                   @map("cover_document_id") @db.Uuid
  termsDocumentId   String?                   @map("terms_document_id") @db.Uuid
  displayOrder      Int                       @default(0) @map("display_order")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version           Int                       @default(1)

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community         Community                 @relation(fields: [communityId], references: [id], onDelete: Cascade)
  coverDocument     Document?                 @relation("AmenityCoverDocument", fields: [coverDocumentId], references: [id], onDelete: SetNull)
  termsDocument     Document?                 @relation("AmenityTermsDocument", fields: [termsDocumentId], references: [id], onDelete: SetNull)

  resources         AmenityResource[]
  operatingSchedules AmenityOperatingSchedule[]
  specialSchedules  AmenitySpecialSchedule[]
  bookingPolicies   AmenityBookingPolicy[]
  pricingPolicies   AmenityPricingPolicy[]
  depositPolicies   AmenityDepositPolicy[]
  cancellationPolicies AmenityCancellationPolicy[]
  bookings          AmenityBooking[]
  holds             BookingHold[]
  waitlists         AmenityWaitlistEntry[]
  blackouts         AmenityBlackout[]
  maintenanceBlocks AmenityMaintenanceBlock[]
  damageReports     AmenityDamageReport[]
  feedbacks         AmenityFeedback[]
  utilizationSummaries AmenityUtilizationSummary[]

  @@unique([communityId, code])
  @@index([communityId, status])
  @@index([category])
  @@map("amenities")
}

model AmenityResource {
  id                String                    @id @default(uuid()) @db.Uuid
  amenityId         String                    @map("amenity_id") @db.Uuid
  code              String                    @map("code") @db.VarChar(50)
  name              String                    @map("name") @db.VarChar(150)
  description       String?                   @db.Text
  resourceType      String                    @default("EXCLUSIVE") @map("resource_type") @db.VarChar(30)
  capacity          Int                       @default(1)
  status            String                    @default("ACTIVE") @db.VarChar(30)
  isExclusive       Boolean                   @default(true) @map("is_exclusive")
  linkedAssetId     String?                   @map("linked_asset_id") @db.Uuid
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version           Int                       @default(1)

  amenity           Amenity                   @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  linkedAsset       Asset?                    @relation(fields: [linkedAssetId], references: [id], onDelete: SetNull)

  bookings          AmenityBooking[]
  holds             BookingHold[]
  waitlists         AmenityWaitlistEntry[]
  blackouts         AmenityBlackout[]
  maintenanceBlocks AmenityMaintenanceBlock[]
  damageReports     AmenityDamageReport[]

  @@unique([amenityId, code])
  @@index([amenityId, status])
  @@map("amenity_resources")
}

model AmenityOperatingSchedule {
  id                String    @id @default(uuid()) @db.Uuid
  amenityId         String    @map("amenity_id") @db.Uuid
  dayOfWeek         Int       @map("day_of_week") // 0=Sunday, 6=Saturday
  openTime          String    @map("open_time") @db.VarChar(10) // e.g. "06:00"
  closeTime         String    @map("close_time") @db.VarChar(10) // e.g. "22:00"
  validFrom         DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil        DateTime? @map("valid_until") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  amenity           Amenity   @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@index([amenityId, dayOfWeek])
  @@map("amenity_operating_schedules")
}

model AmenitySpecialSchedule {
  id                String    @id @default(uuid()) @db.Uuid
  amenityId         String    @map("amenity_id") @db.Uuid
  specificDate      DateTime  @map("specific_date") @db.Date
  isClosed          Boolean   @default(false) @map("is_closed")
  openTime          String?   @map("open_time") @db.VarChar(10)
  closeTime         String?   @map("close_time") @db.VarChar(10)
  reason            String    @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  amenity           Amenity   @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@index([amenityId, specificDate])
  @@map("amenity_special_schedules")
}

model AmenityBookingPolicy {
  id                       String    @id @default(uuid()) @db.Uuid
  amenityId                String    @map("amenity_id") @db.Uuid
  name                     String    @db.VarChar(100)
  slotModel                String    @default("FIXED_SLOT") @map("slot_model") @db.VarChar(30)
  slotDurationMinutes      Int       @default(60) @map("slot_duration_minutes")
  minimumDurationMinutes   Int       @default(60) @map("minimum_duration_minutes")
  maximumDurationMinutes   Int       @default(240) @map("maximum_duration_minutes")
  bufferBeforeMinutes      Int       @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes       Int       @default(15) @map("buffer_after_minutes")
  advanceBookingDays       Int       @default(30) @map("advance_booking_days")
  minimumNoticeMinutes     Int       @default(0) @map("minimum_notice_minutes")
  maxActiveBookingsPerUnit Int       @default(2) @map("max_active_bookings_per_unit")
  maxBookingsPerWeekPerUnit Int      @default(5) @map("max_bookings_per_week_per_unit")
  maxGuests                Int       @default(10) @map("max_guests")
  requiresCheckIn          Boolean   @default(true) @map("requires_check_in")
  checkInGraceMinutes      Int       @default(30) @map("check_in_grace_minutes")
  requiresTermsAcceptance  Boolean   @default(true) @map("requires_terms_acceptance")
  effectiveFrom            DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveUntil           DateTime? @map("effective_until") @db.Timestamptz(6)
  isDefault                Boolean   @default(true) @map("is_default")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  version                  Int       @default(1)

  amenity                  Amenity   @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@index([amenityId, isDefault])
  @@map("amenity_booking_policies")
}

model AmenityPricingPolicy {
  id              String    @id @default(uuid()) @db.Uuid
  amenityId       String    @map("amenity_id") @db.Uuid
  name            String    @db.VarChar(100)
  pricingType     String    @default("FREE") @map("pricing_type") @db.VarChar(30)
