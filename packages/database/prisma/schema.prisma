  visits                 Visit[]
  accessEvents           GateAccessEvent[]
  activeVisits           ActiveVisit[]

  @@index([organizationId])
  @@index([communityId, phoneHash])
  @@index([communityId, normalizedVehicleNumber])
  @@map("visitor_profiles")
}

model VisitorInvitation {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  communityId       String           @map("community_id") @db.Uuid
  invitationNumber  String           @unique @map("invitation_number") @db.VarChar(50)
  hostResidentId    String           @map("host_resident_id") @db.Uuid
  hostHouseholdId   String?          @map("host_household_id") @db.Uuid
  destinationUnitId String           @map("destination_unit_id") @db.Uuid
  visitorName       String           @map("visitor_name") @db.VarChar(150)
  phone             String?          @db.VarChar(30)
  visitType         VisitType        @default(GUEST) @map("visit_type")
  purpose           String?          @db.VarChar(255)
  expectedFrom      DateTime         @map("expected_from") @db.Timestamptz(6)
  expectedUntil     DateTime         @map("expected_until") @db.Timestamptz(6)
  entryCountLimit   Int              @default(1) @map("entry_count_limit")
  vehicleExpected   Boolean          @default(false) @map("vehicle_expected")
  vehicleNumber     String?          @map("vehicle_number") @db.VarChar(30)
  status            InvitationStatus @default(ACTIVE)
  createdById       String?          @map("created_by_id") @db.Uuid
  version           Int              @default(1)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community         Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  hostResident      Resident         @relation("ResidentVisitorInvitations", fields: [hostResidentId], references: [id], onDelete: Cascade)
  hostHousehold     Household?       @relation(fields: [hostHouseholdId], references: [id], onDelete: SetNull)
  destinationUnit   Unit             @relation("UnitVisitorInvitations", fields: [destinationUnitId], references: [id], onDelete: Cascade)
  createdBy         User?            @relation("VisitorInvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  passes            AccessPass[]
  visits            Visit[]
  amenityBookingGuests AmenityBookingGuest[]

  @@index([organizationId])
  @@index([communityId, status])
  @@index([hostResidentId, expectedFrom])
  @@index([destinationUnitId])
  @@map("visitor_invitations")
}

model AccessPass {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  communityId       String             @map("community_id") @db.Uuid
  passNumber        String             @unique @map("pass_number") @db.VarChar(50)
  invitationId      String?            @map("invitation_id") @db.Uuid
  visitId           String?            @map("visit_id") @db.Uuid
  passType          AccessPassType     @default(SINGLE_ENTRY) @map("pass_type")
  credentialType    PassCredentialType @default(QR) @map("credential_type")
  credentialHash    String             @unique @map("credential_hash") @db.VarChar(128)
  rawTokenPreview   String?            @map("raw_token_preview") @db.VarChar(20)
  validFrom         DateTime           @map("valid_from") @db.Timestamptz(6)
  validUntil        DateTime           @map("valid_until") @db.Timestamptz(6)
  entryLimit        Int                @default(1) @map("entry_limit")
  entriesUsed       Int                @default(0) @map("entries_used")
  status            InvitationStatus   @default(ACTIVE)
  revokedAt         DateTime?          @map("revoked_at") @db.Timestamptz(6)
  revokedById       String?            @map("revoked_by_id") @db.Uuid
  version           Int                @default(1)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community         Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  invitation        VisitorInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  visit             Visit?             @relation(fields: [visitId], references: [id], onDelete: SetNull)
  revokedBy         User?              @relation("AccessPassRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  amenityBookingGuests AmenityBookingGuest[]

  @@index([organizationId])
  @@index([communityId, status])
  @@index([credentialHash])
  @@index([validUntil])
  @@map("access_passes")
}

model Visit {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  communityId       String            @map("community_id") @db.Uuid
  visitNumber       String            @unique @map("visit_number") @db.VarChar(50)
  visitorId         String            @map("visitor_id") @db.Uuid
  visitType         VisitType         @default(GUEST) @map("visit_type")
  purpose           String?           @db.VarChar(255)
  hostResidentId    String?           @map("host_resident_id") @db.Uuid
  hostHouseholdId   String?           @map("host_household_id") @db.Uuid
  destinationUnitId String?           @map("destination_unit_id") @db.Uuid
  invitationId      String?           @map("invitation_id") @db.Uuid
  passId            String?           @map("pass_id") @db.Uuid
  status            VisitStatus       @default(EXPECTED)
  expectedFrom      DateTime          @map("expected_from") @db.Timestamptz(6)
  expectedUntil     DateTime          @map("expected_until") @db.Timestamptz(6)
  actualCheckIn     DateTime?         @map("actual_check_in") @db.Timestamptz(6)
  actualCheckOut    DateTime?         @map("actual_check_out") @db.Timestamptz(6)
  entryGateId       String?           @map("entry_gate_id") @db.Uuid
  exitGateId        String?           @map("exit_gate_id") @db.Uuid
  vehicleNumber     String?           @map("vehicle_number") @db.VarChar(30)
  approvalStatus    String            @default("APPROVED") @map("approval_status") @db.VarChar(30)
  overstayFlagged   Boolean           @default(false) @map("overstay_flagged")
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community         Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  visitor           VisitorProfile    @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  hostResident      Resident?         @relation("ResidentVisits", fields: [hostResidentId], references: [id], onDelete: SetNull)
  hostHousehold     Household?        @relation(fields: [hostHouseholdId], references: [id], onDelete: SetNull)
  destinationUnit   Unit?             @relation("UnitVisits", fields: [destinationUnitId], references: [id], onDelete: SetNull)
  invitation        VisitorInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  entryGate         SecurityGate?     @relation("VisitEntryGate", fields: [entryGateId], references: [id], onDelete: SetNull)
  exitGate          SecurityGate?     @relation("VisitExitGate", fields: [exitGateId], references: [id], onDelete: SetNull)
  passes            AccessPass[]
  approvals         VisitApproval[]
  accessEvents      GateAccessEvent[]
  activeVisit       ActiveVisit?
  deliveryDetail    DeliveryVisitDetail?
  overrideLogs      SecurityOverrideLog[]

  @@index([organizationId])
  @@index([communityId, status])
  @@index([destinationUnitId, status])
  @@index([visitorId])
  @@index([actualCheckIn])
  visitorParkingSessions   VisitorParkingSession[]

  @@map("security_visits")
}

model VisitApproval {
