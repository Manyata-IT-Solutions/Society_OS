model Project {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  communityId        String                @map("community_id") @db.Uuid
  projectNumber      String                @map("project_number") @db.VarChar(50)
  name               String                @db.VarChar(200)
  description        String?               @db.Text
  projectType        ProjectType           @default(CAPEX) @map("project_type")
  classification     ProjectClassification @default(CAPEX)
  status             ProjectStatus         @default(DRAFT)
  priority           ProjectPriority       @default(MEDIUM)
  capexInitiativeId  String?               @map("capex_initiative_id") @db.Uuid
  budgetId           String?               @map("budget_id") @db.Uuid
  budgetLineId       String?               @map("budget_line_id") @db.Uuid
  fundId             String?               @map("fund_id") @db.Uuid
  costCenterId       String?               @map("cost_center_id") @db.Uuid
  plannedStartDate   DateTime              @map("planned_start_date") @db.Date
  plannedEndDate     DateTime              @map("planned_end_date") @db.Date
  actualStartDate    DateTime?             @map("actual_start_date") @db.Date
  actualEndDate      DateTime?             @map("actual_end_date") @db.Date
  approvedBudget     Decimal               @map("approved_budget") @db.Decimal(14, 4)
  currency           String                @default("INR") @db.VarChar(10)
  projectManagerId   String?               @map("project_manager_id") @db.Uuid
  workflowInstanceId String?               @map("workflow_instance_id") @db.Uuid
  approvalRequestId  String?               @map("approval_request_id") @db.Uuid
  createdById        String?               @map("created_by_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int                   @default(1)

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community          Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  capexInitiative    CapexInitiative?      @relation(fields: [capexInitiativeId], references: [id], onDelete: SetNull)
  budget             Budget?               @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  budgetLine         BudgetLine?           @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  fund               Fund?                 @relation(fields: [fundId], references: [id], onDelete: SetNull)
  costCenter         CostCenter?           @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  scopes             ProjectScope[]
  locations          ProjectLocationLink[]
  teamMembers        ProjectTeamMember[]
  boqs               BillOfQuantities[]
  workPackages       ProjectWorkPackage[]
  milestones         ProjectMilestone[]
  progressLogs       ProjectProgressLog[]
  measurements       ProjectMeasurement[]
  certificates       ProjectProgressCertificate[]
  retentions         ProjectRetention[]
  variations         ProjectVariation[]
  delays             ProjectDelayEvent[]
  inspections        ProjectInspection[]
  snags              ProjectSnag[]
  handovers          ProjectHandover[]
  assetHandovers     ProjectAssetHandover[]
  financialSummary   ProjectFinancialSummary?

  contractorAuthorizations ContractorAccessAuthorization[]
  @@unique([organizationId, projectNumber])
  @@index([communityId, status])
  @@index([capexInitiativeId])
  blockedParkingSlots      ParkingSlotBlock[]
  amenityMaintenanceBlocks AmenityMaintenanceBlock[]
  workforceDeployments          WorkforceDeployment[]
  workforceTimesheets           WorkforceTimesheet[]

  @@map("projects")
}

