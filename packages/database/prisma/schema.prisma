}

model BankTransaction {
  id              String                   @id @default(uuid()) @db.Uuid
  bankStatementId String                   @map("bank_statement_id") @db.Uuid
  bankAccountId   String                   @map("bank_account_id") @db.Uuid
  transactionDate DateTime                 @map("transaction_date") @db.Date
  valueDate       DateTime?                @map("value_date") @db.Date
  description     String                   @db.VarChar(500)
  bankReference   String?                  @map("bank_reference") @db.VarChar(100)
  amount          Decimal                  @db.Decimal(14, 4)
  direction       BankTransactionDirection
  runningBalance  Decimal?                 @map("running_balance") @db.Decimal(14, 4)
  status          BankMatchStatus          @default(UNMATCHED)
  fingerprint     String                   @db.VarChar(128)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  bankStatement   BankStatement            @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount              @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  matches         BankMatch[]

  @@unique([bankAccountId, fingerprint])
  @@index([bankAccountId, transactionDate])
  @@index([status])
  @@map("bank_transactions")
}

model BankReconciliationSession {
  id                     String                   @id @default(uuid()) @db.Uuid
  bankAccountId          String                   @map("bank_account_id") @db.Uuid
  statementId            String?                  @map("statement_id") @db.Uuid
  sessionNumber          String                   @map("session_number") @db.VarChar(50)
  periodStart            DateTime                 @map("period_start") @db.Date
  periodEnd              DateTime                 @map("period_end") @db.Date
  bookOpeningBalance     Decimal                  @default(0) @map("book_opening_balance") @db.Decimal(14, 4)
  statementOpeningBalance Decimal                 @default(0) @map("statement_opening_balance") @db.Decimal(14, 4)
  bookClosingBalance     Decimal                  @default(0) @map("book_closing_balance") @db.Decimal(14, 4)
  statementClosingBalance Decimal                 @default(0) @map("statement_closing_balance") @db.Decimal(14, 4)
  unmatchedDebitsTotal   Decimal                  @default(0) @map("unmatched_debits_total") @db.Decimal(14, 4)
  unmatchedCreditsTotal  Decimal                  @default(0) @map("unmatched_credits_total") @db.Decimal(14, 4)
  difference             Decimal                  @default(0) @db.Decimal(14, 4)
  status                 BankReconciliationStatus @default(DRAFT)
  notes                  String?                  @db.Text
  createdById            String?                  @map("created_by_id") @db.Uuid
  completedById          String?                  @map("completed_by_id") @db.Uuid
  completedAt            DateTime?                @map("completed_at") @db.Timestamptz(6)
  reopenedById           String?                  @map("reopened_by_id") @db.Uuid
  reopenedAt             DateTime?                @map("reopened_at") @db.Timestamptz(6)
  reopenReason           String?                  @map("reopen_reason") @db.Text
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                Int                      @default(1)

  bankAccount            BankAccount              @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  statement              BankStatement?           @relation(fields: [statementId], references: [id], onDelete: SetNull)

  matches                BankMatch[]

  @@unique([bankAccountId, sessionNumber])
  @@index([bankAccountId, status])
  @@map("bank_reconciliation_sessions")
}

model BankMatch {
  id                String              @id @default(uuid()) @db.Uuid
  sessionId         String              @map("session_id") @db.Uuid
  bankTransactionId String              @map("bank_transaction_id") @db.Uuid
  vendorPaymentId   String?             @map("vendor_payment_id") @db.Uuid
  residentPaymentId String?             @map("resident_payment_id") @db.Uuid
  journalEntryId    String?             @map("journal_entry_id") @db.Uuid
  matchConfidence   BankMatchConfidence @default(EXACT) @map("match_confidence")
  matchType         String              @default("AUTO") @map("match_type") @db.VarChar(50)
  matchedAmount     Decimal             @map("matched_amount") @db.Decimal(14, 4)
  notes             String?             @db.Text
  createdById       String?             @map("created_by_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  session           BankReconciliationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  bankTransaction   BankTransaction           @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  vendorPayment     VendorPayment?            @relation(fields: [vendorPaymentId], references: [id], onDelete: SetNull)
  residentPayment   Payment?                  @relation(fields: [residentPaymentId], references: [id], onDelete: SetNull)
  journalEntry      JournalEntry?             @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([bankTransactionId])
  @@index([vendorPaymentId])
  @@index([residentPaymentId])
  @@index([journalEntryId])
  @@map("bank_matches")
}


