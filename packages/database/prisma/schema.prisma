  userId             String?                   @map("user_id") @db.Uuid
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int                       @default(1)

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryCommunity   Community?                @relation(fields: [primaryCommunityId], references: [id], onDelete: SetNull)
  user               User?                     @relation("WorkerUserLink", fields: [userId], references: [id], onDelete: SetNull)
  photoDocument      Document?                 @relation("WorkerPhotoDocument", fields: [photoDocumentId], references: [id], onDelete: SetNull)

  engagements        WorkerEngagement[]
  skills             WorkerSkill[]
  certifications     WorkerCertification[]
  shiftAssignments   ShiftAssignment[]
  attendanceSessions AttendanceSession[]
  attendanceEvents   AttendanceEvent[]
  leaveRequests      LeaveRequest[]
  overtimeRecords    OvertimeRecord[]
  timesheets         WorkforceTimesheet[]
  deployments        WorkforceDeployment[]
  tasks              WorkforceTask[]
  governanceActionItems GovernanceActionItem[]
  tankersReceived       WaterTankerDelivery[]
  dgSessionsRun         DGRunSession[]

  @@index([organizationId, status])
  @@index([primaryCommunityId, status])
  @@index([userId])
  @@index([workerNumber])
    incidentCommands      IncidentCommand[]
  responderAssignments  IncidentResponderAssignment[]
  investigationsLed     IncidentInvestigation[]
  permitsReceived       SafetyPermitToWork[] @relation("PermitReceivers")
  permitsIssued         SafetyPermitToWork[] @relation("PermitIssuers")

  @@map("workforce_workers")
}

