  defaultPriority      TicketPriority       @default(NORMAL) @map("default_priority")
  defaultSlaPolicyId   String?              @map("default_sla_policy_id") @db.Uuid
  defaultTeamId        String?              @map("default_team_id") @db.Uuid
  workflowDefinitionId String?              @map("workflow_definition_id") @db.Uuid
  residentVisible      Boolean              @default(true) @map("resident_visible")
  isSensitive          Boolean              @default(false) @map("is_sensitive")
  allowAttachments     Boolean              @default(true) @map("allow_attachments")
  displayOrder         Int                  @default(0) @map("display_order")
  createdById          String?              @map("created_by_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent             TicketCategory?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories      TicketCategory[]     @relation("CategoryHierarchy")
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community          Community?           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  defaultSlaPolicy   SlaPolicyDefinition? @relation(fields: [defaultSlaPolicyId], references: [id], onDelete: SetNull)
  defaultTeam        HelpdeskTeam?        @relation("CategoryDefaultTeam", fields: [defaultTeamId], references: [id], onDelete: SetNull)
  workflowDefinition WorkflowDefinition?  @relation(fields: [workflowDefinitionId], references: [id], onDelete: SetNull)
  createdByUser      User?                @relation("TicketCategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tickets            Ticket[]             @relation("TicketCategory")
  subcategoryTickets Ticket[]             @relation("TicketSubcategory")

  @@unique([organizationId, communityId, key])
  @@index([organizationId, communityId, status])
  @@index([parentId])
  @@map("ticket_categories")
}

model HelpdeskTeam {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  communityId    String?            @map("community_id") @db.Uuid
  key            String             @db.VarChar(100)
  name           String             @db.VarChar(150)
  description    String?            @db.VarChar(500)
  status         HelpdeskTeamStatus @default(ACTIVE)
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization               Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community                  Community?                   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdByUser              User?                        @relation("HelpdeskTeamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members                    HelpdeskTeamMember[]
  tickets                    Ticket[]                     @relation("TicketAssignedTeam")
  defaultForCategories       TicketCategory[]             @relation("CategoryDefaultTeam")
  assignmentsFrom            TicketAssignmentHistory[]    @relation("AssignmentFromTeam")
  assignmentsTo              TicketAssignmentHistory[]    @relation("AssignmentToTeam")
  assignedWorkOrders         WorkOrder[]                  @relation("WorkOrderAssignedTeam")
  workOrderAssignmentsFrom   WorkOrderAssignmentHistory[] @relation("WorkOrderAssignmentFromTeam")
  workOrderAssignmentsTo     WorkOrderAssignmentHistory[] @relation("WorkOrderAssignmentToTeam")
  defaultForWorkCategories   FacilityWorkCategory[]       @relation("FacilityCategoryDefaultTeam")
  defaultForMaintenancePlans MaintenancePlan[]            @relation("MaintenancePlanDefaultTeam")

  @@unique([organizationId, communityId, key])
  @@index([organizationId, communityId, status])
  @@map("helpdesk_teams")
}

model HelpdeskTeamMember {
  id         String   @id @default(uuid()) @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleInTeam String?  @map("role_in_team") @db.VarChar(100)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team HelpdeskTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User         @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId, isActive])
  @@map("helpdesk_team_members")
}

model TicketSequence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  communityId    String   @map("community_id") @db.Uuid
  year           Int
  prefix         String   @default("TKT") @db.VarChar(20)
  currentNumber  Int      @default(0) @map("current_number")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community    Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, communityId, year, prefix])
  @@map("ticket_sequences")
}

model Ticket {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  communityId          String             @map("community_id") @db.Uuid
  ticketNumber         String             @map("ticket_number") @db.VarChar(50)
  title                String             @db.VarChar(255)
  description          String             @db.Text
  categoryId           String             @map("category_id") @db.Uuid
  subcategoryId        String?            @map("subcategory_id") @db.Uuid
  priority             TicketPriority     @default(NORMAL)
  currentState         String             @default("NEW") @map("current_state") @db.VarChar(100)
  source               TicketSource       @default(ADMIN_WEB)
  locationType         TicketLocationType @default(UNIT) @map("location_type")
  propertySectionId    String?            @map("property_section_id") @db.Uuid
  buildingId           String?            @map("building_id") @db.Uuid
  floorId              String?            @map("floor_id") @db.Uuid
  unitId               String?            @map("unit_id") @db.Uuid
  locationDescription  String?            @map("location_description") @db.VarChar(500)
  reportedByResidentId String?            @map("reported_by_resident_id") @db.Uuid
  reportedByUserId     String?            @map("reported_by_user_id") @db.Uuid
  assignedTeamId       String?            @map("assigned_team_id") @db.Uuid
  assignedUserId       String?            @map("assigned_user_id") @db.Uuid
  workflowInstanceId   String             @unique @map("workflow_instance_id") @db.Uuid
  slaInstanceId        String?            @map("sla_instance_id") @db.Uuid
  slaStatus            SlaInstanceStatus? @map("sla_status")
  slaDueAt             DateTime?          @map("sla_due_at") @db.Timestamptz(6)
  slaWarningAt         DateTime?          @map("sla_warning_at") @db.Timestamptz(6)
  slaBreachedAt        DateTime?          @map("sla_breached_at") @db.Timestamptz(6)
  reopenCount          Int                @default(0) @map("reopen_count")
  reopenedAt           DateTime?          @map("reopened_at") @db.Timestamptz(6)
  resolutionSummary    String?            @map("resolution_summary") @db.Text
  resolutionCode       String?            @map("resolution_code") @db.VarChar(100)
  resolvedById         String?            @map("resolved_by_id") @db.Uuid
  resolvedAt           DateTime?          @map("resolved_at") @db.Timestamptz(6)
  closedAt             DateTime?          @map("closed_at") @db.Timestamptz(6)
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason   String?            @map("cancellation_reason") @db.VarChar(500)
  duplicateOfTicketId  String?            @map("duplicate_of_ticket_id") @db.Uuid
  version              Int                @default(1)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community          Community                 @relation(fields: [communityId], references: [id], onDelete: Cascade)
  category           TicketCategory            @relation("TicketCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory        TicketCategory?           @relation("TicketSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  propertySection    CommunitySection?         @relation(fields: [propertySectionId], references: [id], onDelete: SetNull)
  building           Building?                 @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor              Floor?                    @relation(fields: [floorId], references: [id], onDelete: SetNull)
  unit               Unit?                     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  reportedByResident Resident?                 @relation(fields: [reportedByResidentId], references: [id], onDelete: SetNull)
  reportedByUser     User?                     @relation("TicketReportedBy", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  assignedTeam       HelpdeskTeam?             @relation("TicketAssignedTeam", fields: [assignedTeamId], references: [id], onDelete: SetNull)
  assignedUser       User?                     @relation("TicketAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  resolvedByUser     User?                     @relation("TicketResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  workflowInstance   WorkflowInstance          @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  slaInstance        SlaInstance?              @relation(fields: [slaInstanceId], references: [id], onDelete: SetNull)
  duplicateOfTicket  Ticket?                   @relation("TicketDuplicateSelf", fields: [duplicateOfTicketId], references: [id], onDelete: SetNull)
  duplicates         Ticket[]                  @relation("TicketDuplicateSelf")
  comments           TicketComment[]
  feedback           TicketFeedback?
  assignmentHistory  TicketAssignmentHistory[]
  relationsFrom      TicketRelation[]          @relation("RelationSourceTicket")
  relationsTo        TicketRelation[]          @relation("RelationTargetTicket")
  workOrderLinks     TicketWorkOrderLink[]

  @@unique([organizationId, communityId, ticketNumber])
  @@index([communityId, createdAt])
  @@index([communityId, currentState])
  @@index([communityId, priority])
  @@index([communityId, categoryId])
  @@index([assignedTeamId, currentState])
  @@index([assignedUserId, currentState])
  @@index([slaStatus, slaDueAt])
  @@index([unitId])
  @@index([buildingId])
  @@index([reportedByResidentId])
  @@index([reportedByUserId])
  @@map("tickets")
}

model TicketComment {
  id               String            @id @default(uuid()) @db.Uuid
  ticketId         String            @map("ticket_id") @db.Uuid
  authorUserId     String?           @map("author_user_id") @db.Uuid
  authorResidentId String?           @map("author_resident_id") @db.Uuid
  type             TicketCommentType @default(PUBLIC_REPLY)
  body             String            @db.Text
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  editedAt         DateTime?         @map("edited_at") @db.Timestamptz(6)

  ticket         Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser     User?     @relation("CommentAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorResident Resident? @relation(fields: [authorResidentId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([type])
  @@map("ticket_comments")
}

model TicketAssignmentHistory {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  fromTeamId   String?  @map("from_team_id") @db.Uuid
  toTeamId     String?  @map("to_team_id") @db.Uuid
  fromUserId   String?  @map("from_user_id") @db.Uuid
  toUserId     String?  @map("to_user_id") @db.Uuid
  assignedById String   @map("assigned_by_id") @db.Uuid
  reason       String?  @db.VarChar(500)
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  ticket         Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromTeam       HelpdeskTeam? @relation("AssignmentFromTeam", fields: [fromTeamId], references: [id], onDelete: SetNull)
  toTeam         HelpdeskTeam? @relation("AssignmentToTeam", fields: [toTeamId], references: [id], onDelete: SetNull)
  fromUser       User?         @relation("AssignmentFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser         User?         @relation("AssignmentToUser", fields: [toUserId], references: [id], onDelete: SetNull)
  assignedByUser User          @relation("AssignmentAssignerUser", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([ticketId, assignedAt])
  @@map("ticket_assignment_history")
}

model TicketFeedback {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @unique @map("ticket_id") @db.Uuid
  residentId  String?  @map("resident_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  rating      Int
  comment     String?  @db.Text
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  ticket   Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  resident Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  user     User      @relation("TicketFeedbackUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rating])
  @@map("ticket_feedback")
}

model TicketRelation {
  id             String             @id @default(uuid()) @db.Uuid
  sourceTicketId String             @map("source_ticket_id") @db.Uuid
  targetTicketId String             @map("target_ticket_id") @db.Uuid
  relationType   TicketRelationType @default(RELATED_TO) @map("relation_type")
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  sourceTicket  Ticket @relation("RelationSourceTicket", fields: [sourceTicketId], references: [id], onDelete: Cascade)
  targetTicket  Ticket @relation("RelationTargetTicket", fields: [targetTicketId], references: [id], onDelete: Cascade)
  createdByUser User?  @relation("TicketRelationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([sourceTicketId, targetTicketId, relationType])
  @@map("ticket_relations")
}

// =============================================================================
// PHASE 9: ENTERPRISE FACILITY MANAGEMENT & WORK EXECUTION
// =============================================================================

enum WorkOrderType {
  CORRECTIVE
  PREVENTIVE
  INSPECTION
  ROUTINE
  EMERGENCY
  OTHER
}

enum WorkOrderSource {
  HELPDESK_TICKET
  PREVENTIVE_PLAN
  MANUAL
  INSPECTION
  SYSTEM
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum WorkOrderLocationType {
  COMMUNITY
  SECTION
  BUILDING
  FLOOR
  UNIT
  COMMON_AREA
  OTHER
}

enum TicketWorkOrderRelationType {
  GENERATED_FROM
  RELATED_WORK
  FOLLOW_UP
}

enum WorkOrderTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  BLOCKED
}

enum FacilityChecklistTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ChecklistItemType {
  BOOLEAN
  PASS_FAIL
  TEXT
  NUMBER
  DECIMAL
  DATE
  SELECT
  PHOTO_REQUIRED
}

enum MaintenancePlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MaintenanceScheduleType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM_RRULE
}

enum MaintenanceMissedPolicy {
  SKIP_MISSED
  GENERATE_LATEST
  GENERATE_ALL_WITH_LIMIT
}

enum WorkLogType {
  WORK
  TRAVEL
  WAITING
  INSPECTION
}

enum WorkEvidenceType {
  WORK_ORDER_ATTACHMENT
  BEFORE_PHOTO
  AFTER_PHOTO
  COMPLETION_PROOF
  CHECKLIST_EVIDENCE
}

enum WorkOrderBlockerReason {
  PART_REQUIRED
  VENDOR_REQUIRED
  ACCESS_REQUIRED
  RESIDENT_RESPONSE
  SAFETY
  WEATHER
  OTHER
}

enum CompletionReviewOutcome {
  APPROVED
  REWORK_REQUESTED
}

model FacilityWorkCategory {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  communityId        String?           @map("community_id") @db.Uuid
  key                String            @db.VarChar(100)
  name               String            @db.VarChar(150)
  description        String?           @db.VarChar(500)
  status             EntityStatus      @default(ACTIVE)
  defaultTeamId      String?           @map("default_team_id") @db.Uuid
  defaultPriority    WorkOrderPriority @default(NORMAL) @map("default_priority")
  defaultSlaPolicyId String?           @map("default_sla_policy_id") @db.Uuid
  createdById        String?           @map("created_by_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community          Community?                  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  defaultTeam        HelpdeskTeam?               @relation("FacilityCategoryDefaultTeam", fields: [defaultTeamId], references: [id], onDelete: SetNull)
  createdByUser      User?                       @relation("FacilityCategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  workOrders         WorkOrder[]
  maintenancePlans   MaintenancePlan[]
  checklistTemplates FacilityChecklistTemplate[]

  @@unique([organizationId, communityId, key])
  @@index([organizationId, communityId, status])
  @@map("facility_work_categories")
}

model WorkOrderSequence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  communityId    String   @map("community_id") @db.Uuid
  year           Int
  prefix         String   @default("WO") @db.VarChar(20)
  currentNumber  Int      @default(0) @map("current_number")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community    Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, communityId, year, prefix])
  @@map("work_order_sequences")
}

model WorkOrder {
  id                    String                  @id @default(uuid()) @db.Uuid
  organizationId        String                  @map("organization_id") @db.Uuid
  communityId           String                  @map("community_id") @db.Uuid
  workOrderNumber       String                  @map("work_order_number") @db.VarChar(50)
  title                 String                  @db.VarChar(255)
  description           String                  @db.Text
  workType              WorkOrderType           @default(CORRECTIVE) @map("work_type")
  priority              WorkOrderPriority       @default(NORMAL)
  categoryId            String?                 @map("category_id") @db.Uuid
  locationType          WorkOrderLocationType   @default(COMMON_AREA) @map("location_type")
  propertySectionId     String?                 @map("property_section_id") @db.Uuid
  buildingId            String?                 @map("building_id") @db.Uuid
  floorId               String?                 @map("floor_id") @db.Uuid
  unitId                String?                 @map("unit_id") @db.Uuid
  locationDescription   String?                 @map("location_description") @db.VarChar(500)
  source                WorkOrderSource         @default(MANUAL)
  maintenancePlanId     String?                 @map("maintenance_plan_id") @db.Uuid
  planVersion           Int?                    @map("plan_version")
  scheduledOccurrenceAt DateTime?               @map("scheduled_occurrence_at") @db.Timestamptz(6)
  workflowInstanceId    String                  @unique @map("workflow_instance_id") @db.Uuid
  slaInstanceId         String?                 @map("sla_instance_id") @db.Uuid
  slaStatus             SlaInstanceStatus?      @map("sla_status")
  slaDueAt              DateTime?               @map("sla_due_at") @db.Timestamptz(6)
  slaWarningAt          DateTime?               @map("sla_warning_at") @db.Timestamptz(6)
  slaBreachedAt         DateTime?               @map("sla_breached_at") @db.Timestamptz(6)
  currentState          String                  @default("DRAFT") @map("current_state") @db.VarChar(100)
  scheduledStartAt      DateTime?               @map("scheduled_start_at") @db.Timestamptz(6)
  scheduledEndAt        DateTime?               @map("scheduled_end_at") @db.Timestamptz(6)
  actualStartAt         DateTime?               @map("actual_start_at") @db.Timestamptz(6)
  actualEndAt           DateTime?               @map("actual_end_at") @db.Timestamptz(6)
  dueAt                 DateTime?               @map("due_at") @db.Timestamptz(6)
  primaryTeamId         String?                 @map("primary_team_id") @db.Uuid
  primaryAssigneeId     String?                 @map("primary_assignee_id") @db.Uuid
  isAccepted            Boolean                 @default(false) @map("is_accepted")
  acceptedAt            DateTime?               @map("accepted_at") @db.Timestamptz(6)
  isBlocked             Boolean                 @default(false) @map("is_blocked")
  blockedReason         String?                 @map("blocked_reason") @db.VarChar(500)
  blockedCategory       WorkOrderBlockerReason? @map("blocked_category")
  blockedAt             DateTime?               @map("blocked_at") @db.Timestamptz(6)
  isPaused              Boolean                 @default(false) @map("is_paused")
  pausedAt              DateTime?               @map("paused_at") @db.Timestamptz(6)
  reworkCount           Int                     @default(0) @map("rework_count")
  completionSummary     String?                 @map("completion_summary") @db.Text
  resolutionCode        String?                 @map("resolution_code") @db.VarChar(100)
  verifiedById          String?                 @map("verified_by_id") @db.Uuid
  verifiedAt            DateTime?               @map("verified_at") @db.Timestamptz(6)
  cancelledById         String?                 @map("cancelled_by_id") @db.Uuid
  cancelledAt           DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason    String?                 @map("cancellation_reason") @db.VarChar(500)
  version               Int                     @default(1)
  createdById           String?                 @map("created_by_id") @db.Uuid
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization             Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community                Community                      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  category                 FacilityWorkCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  propertySection          CommunitySection?              @relation(fields: [propertySectionId], references: [id], onDelete: SetNull)
  building                 Building?                      @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor                    Floor?                         @relation(fields: [floorId], references: [id], onDelete: SetNull)
  unit                     Unit?                          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  maintenancePlan          MaintenancePlan?               @relation(fields: [maintenancePlanId], references: [id], onDelete: SetNull)
  workflowInstance         WorkflowInstance               @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  slaInstance              SlaInstance?                   @relation(fields: [slaInstanceId], references: [id], onDelete: SetNull)
  primaryTeam              HelpdeskTeam?                  @relation("WorkOrderAssignedTeam", fields: [primaryTeamId], references: [id], onDelete: SetNull)
  primaryAssignee          User?                          @relation("WorkOrderPrimaryAssignee", fields: [primaryAssigneeId], references: [id], onDelete: SetNull)
  createdByUser            User?                          @relation("WorkOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  verifiedByUser           User?                          @relation("WorkOrderVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  cancelledByUser          User?                          @relation("WorkOrderCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  ticketLinks              TicketWorkOrderLink[]
  tasks                    WorkOrderTask[]
  checklistResults         WorkOrderChecklistResult[]
  workLogs                 WorkLog[]
  assignmentHistory        WorkOrderAssignmentHistory[]
  evidence                 WorkOrderEvidence[]
  completionAttempts       WorkCompletionAttempt[]
  planOccurrences          MaintenancePlanOccurrence[]
  assetLinks               WorkOrderAssetLink[]
  materialRequirements     WorkOrderMaterialRequirement[]
  stockReservations        StockReservation[]
  materialConsumptions     WorkOrderMaterialConsumption[]
  inventoryIssues          InventoryIssue[]
  inventoryReturns         InventoryReturn[]
  inventorySerials         InventorySerial[]
  purchaseRequisitionLines PurchaseRequisitionLine[]
  purchaseOrderLines       PurchaseOrderLine[]

