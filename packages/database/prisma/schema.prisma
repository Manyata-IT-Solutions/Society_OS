// PHASE 10: ENTERPRISE ASSET MANAGEMENT ENUMS
// =============================================================================

enum AssetLifecycleState {
  REGISTERED
  INSTALLED
  COMMISSIONED
  ACTIVE
  SUSPENDED
  DECOMMISSIONED
  DISPOSED
}

enum AssetOperationalStatus {
  OPERATIONAL
  DEGRADED
  OUT_OF_SERVICE
  UNDER_MAINTENANCE
  UNKNOWN
}

enum AssetCondition {
  GOOD
  FAIR
  POOR
  CRITICAL
  UNKNOWN
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetWarrantyStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  VOID
}

enum ServiceContractType {
  AMC
  CMC
  WARRANTY_SERVICE
  ON_CALL
  OTHER
}

enum ServiceContractStatus {
  DRAFT
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TERMINATED
}

enum AssetMeterType {
  RUN_HOURS
  CYCLES
  KWH
  KM
  PRESSURE
  TEMPERATURE
  CUSTOM
}

enum AssetMeterReadingSource {
  MANUAL
  WORK_ORDER
  IMPORT
  IOT
}

enum WorkOrderAssetRelationType {
  PRIMARY_ASSET
  RELATED_ASSET
  COMPONENT
}

enum AssetDowntimeReason {
  BREAKDOWN
  EMERGENCY_REPAIR
  SCHEDULED_MAINTENANCE
  POWER_OUTAGE
  OTHER
}

enum AssetDowntimeImpact {
  FULL_OUTAGE
  PARTIAL_DEGRADATION
  NO_IMPACT
}

enum AssetServiceRecordType {
  CORRECTIVE
  PREVENTIVE
  INSPECTION
  OVERHAUL
  COMMISSIONING
}

enum AssetServiceRecordSource {
  WORK_ORDER
  MANUAL_ENTRY
  IMPORT
}

enum AssetImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// =============================================================================
// PHASE 10: ASSET MANAGEMENT MODELS
// =============================================================================

model AssetCategory {
  id                       String           @id @default(uuid()) @db.Uuid
  organizationId           String           @map("organization_id") @db.Uuid
  communityId              String?          @map("community_id") @db.Uuid
  code                     String           @db.VarChar(100)
  name                     String           @db.VarChar(255)
  description              String?          @db.Text
  parentId                 String?          @map("parent_id") @db.Uuid
  status                   EntityStatus     @default(ACTIVE)
  icon                     String?          @db.VarChar(100)
  defaultCriticality       AssetCriticality @default(MEDIUM) @map("default_criticality")
  defaultExpectedLifeYears Int?             @map("default_expected_life_years")
  customFieldDefinitions   Json             @default("[]") @map("custom_field_definitions") @db.JsonB
  createdById              String?          @map("created_by_id") @db.Uuid
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community       Community?      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  parentCategory  AssetCategory?  @relation("AssetCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  childCategories AssetCategory[] @relation("AssetCategoryHierarchy")
  createdByUser   User?           @relation("AssetCategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  models          AssetModel[]
  assets          Asset[]

  @@unique([organizationId, communityId, code])
  @@index([organizationId, status])
  @@index([communityId, status])
  @@map("asset_categories")
}

model AssetModel {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  communityId       String?      @map("community_id") @db.Uuid
  categoryId        String       @map("category_id") @db.Uuid
  manufacturer      String       @db.VarChar(255)
  modelName         String       @map("model_name") @db.VarChar(255)
  modelNumber       String       @map("model_number") @db.VarChar(100)
  description       String?      @db.Text
  expectedLifeYears Int?         @map("expected_life_years")
  specifications    Json         @default("{}") @db.JsonB
  status            EntityStatus @default(ACTIVE)
  createdById       String?      @map("created_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community     Community?    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  category      AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdByUser User?         @relation("AssetModelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assets        Asset[]

  @@unique([organizationId, communityId, manufacturer, modelNumber])
  @@index([categoryId, status])
  @@map("asset_models")
}

model Asset {
  id                     String                 @id @default(uuid()) @db.Uuid
  organizationId         String                 @map("organization_id") @db.Uuid
  communityId            String                 @map("community_id") @db.Uuid
  assetCode              String                 @map("asset_code") @db.VarChar(100)
  name                   String                 @db.VarChar(255)
  description            String?                @db.Text
  assetCategoryId        String                 @map("asset_category_id") @db.Uuid
  assetModelId           String?                @map("asset_model_id") @db.Uuid
  status                 EntityStatus           @default(ACTIVE)
  lifecycleState         AssetLifecycleState    @default(REGISTERED) @map("lifecycle_state")
  operationalStatus      AssetOperationalStatus @default(OPERATIONAL) @map("operational_status")
  condition              AssetCondition         @default(GOOD)
  criticality            AssetCriticality       @default(MEDIUM)
  locationType           WorkOrderLocationType  @default(COMMUNITY) @map("location_type")
  propertySectionId      String?                @map("property_section_id") @db.Uuid
  buildingId             String?                @map("building_id") @db.Uuid
  floorId                String?                @map("floor_id") @db.Uuid
  unitId                 String?                @map("unit_id") @db.Uuid
  locationDescription    String?                @map("location_description") @db.VarChar(500)
  parentAssetId          String?                @map("parent_asset_id") @db.Uuid
  isMovable              Boolean                @default(false) @map("is_movable")
  serialNumber           String?                @map("serial_number") @db.VarChar(100)
  manufacturer           String?                @db.VarChar(255)
  modelNumber            String?                @map("model_number") @db.VarChar(100)
  purchaseDate           DateTime?              @map("purchase_date") @db.Timestamptz(6)
  installationDate       DateTime?              @map("installation_date") @db.Timestamptz(6)
  commissionedAt         DateTime?              @map("commissioned_at") @db.Timestamptz(6)
  commissionedById       String?                @map("commissioned_by_id") @db.Uuid
  commissioningNotes     String?                @map("commissioning_notes") @db.Text
  warrantyStartDate      DateTime?              @map("warranty_start_date") @db.Timestamptz(6)
  warrantyEndDate        DateTime?              @map("warranty_end_date") @db.Timestamptz(6)
  warrantyProviderName   String?                @map("warranty_provider_name") @db.VarChar(255)
  expectedLifeYears      Int?                   @map("expected_life_years")
  decommissionedAt       DateTime?              @map("decommissioned_at") @db.Timestamptz(6)
  decommissionedById     String?                @map("decommissioned_by_id") @db.Uuid
  decommissionReason     String?                @map("decommission_reason") @db.Text
  replacementAssetId     String?                @map("replacement_asset_id") @db.Uuid
  disposedAt             DateTime?              @map("disposed_at") @db.Timestamptz(6)
  disposedById           String?                @map("disposed_by_id") @db.Uuid
  disposalReason         String?                @map("disposal_reason") @db.Text
  disposalMethod         String?                @map("disposal_method") @db.VarChar(100)
  qrIdentifier           String                 @unique @map("qr_identifier") @db.VarChar(100)
  barcodeIdentifier      String?                @unique @map("barcode_identifier") @db.VarChar(100)
  primaryPhotoDocumentId String?                @map("primary_photo_document_id") @db.Uuid
  nextMaintenanceDueAt   DateTime?              @map("next_maintenance_due_at") @db.Timestamptz(6)
  lastMaintenanceAt      DateTime?              @map("last_maintenance_at") @db.Timestamptz(6)
  version                Int                    @default(1)
  createdById            String?                @map("created_by_id") @db.Uuid
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community            Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  category             AssetCategory     @relation(fields: [assetCategoryId], references: [id], onDelete: Restrict)
  model                AssetModel?       @relation(fields: [assetModelId], references: [id], onDelete: SetNull)
  propertySection      CommunitySection? @relation(fields: [propertySectionId], references: [id], onDelete: SetNull)
  building             Building?         @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor                Floor?            @relation(fields: [floorId], references: [id], onDelete: SetNull)
  unit                 Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
