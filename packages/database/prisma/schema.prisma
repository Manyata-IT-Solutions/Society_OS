model SupplierInvoice {
  progressCertificates ProjectProgressCertificate[]
  id                      String                    @id @default(uuid()) @db.Uuid
  organizationId          String                    @map("organization_id") @db.Uuid
  accountingEntityId      String                    @map("accounting_entity_id") @db.Uuid
