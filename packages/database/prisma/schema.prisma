  rfqLines                 RfqLine[]
  vendorQuotationLines     VendorQuotationLine[]
  purchaseOrderLines       PurchaseOrderLine[]
  grnLines                 GrnLine[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("unit_of_measures")
