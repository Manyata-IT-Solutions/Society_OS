  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                 Int                   @default(1)

  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community               Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  document                Document?             @relation("NoticeDocument", fields: [documentId], references: [id], onDelete: SetNull)
  createdBy               User?                 @relation("CreatedGovernanceNotices", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy              User?                 @relation("ApprovedGovernanceNotices", fields: [approvedById], references: [id], onDelete: SetNull)

  readReceipts            NoticeReadReceipt[]
  acknowledgements        NoticeAcknowledgement[]

  @@index([communityId, publishAt])
  @@index([noticeType, status])
  @@map("governance_notices")
}

model NoticeReadReceipt {
  id          String                @id @default(uuid()) @db.Uuid
  noticeId    String                @map("notice_id") @db.Uuid
  residentId  String?               @map("resident_id") @db.Uuid
  userId      String?               @map("user_id") @db.Uuid
  firstReadAt DateTime              @default(now()) @map("first_read_at") @db.Timestamptz(6)
  lastReadAt  DateTime              @default(now()) @map("last_read_at") @db.Timestamptz(6)

  notice      GovernanceNotice      @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  resident    Resident?             @relation("ResidentNoticeReadReceipts", fields: [residentId], references: [id], onDelete: Cascade)
  user        User?                 @relation("NoticeReadReceipts", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([noticeId, residentId])
  @@map("governance_notice_read_receipts")
}

model NoticeAcknowledgement {
  id             String                @id @default(uuid()) @db.Uuid
  noticeId       String                @map("notice_id") @db.Uuid
  residentId     String?               @map("resident_id") @db.Uuid
  userId         String?               @map("user_id") @db.Uuid
  acknowledgedAt DateTime              @default(now()) @map("acknowledged_at") @db.Timestamptz(6)
  method         String                @default("IN_APP") @db.VarChar(30)
  status         String                @default("ACKNOWLEDGED") @db.VarChar(30)

  notice         GovernanceNotice      @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  resident       Resident?             @relation("ResidentNoticeAcknowledgements", fields: [residentId], references: [id], onDelete: Cascade)
  user           User?                 @relation("NoticeAcknowledgements", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([noticeId, residentId])
  @@map("governance_notice_acknowledgements")
}

model GovernancePolicy {
  id               String                    @id @default(uuid()) @db.Uuid
  organizationId   String                    @map("organization_id") @db.Uuid
  communityId      String                    @map("community_id") @db.Uuid
  policyNumber     String                    @unique @map("policy_number") @db.VarChar(50)
  title            String                    @db.VarChar(200)
  category         String                    @default("GENERAL") @db.VarChar(50)
  description      String?                   @db.Text
  status           String                    @default("EFFECTIVE") @db.VarChar(30)
  ownerCommitteeId String?                   @map("owner_committee_id") @db.Uuid
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int                       @default(1)

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  community        Community                 @relation(fields: [communityId], references: [id], onDelete: Cascade)
  ownerCommittee   GovernanceCommittee?      @relation(fields: [ownerCommitteeId], references: [id], onDelete: SetNull)

  versions         GovernancePolicyVersion[]

  @@index([communityId, category])
  @@map("governance_policies")
}

model GovernancePolicyVersion {
  id            String                @id @default(uuid()) @db.Uuid
  policyId      String                @map("policy_id") @db.Uuid
  versionNumber Int                   @default(1) @map("version_number")
  content       String                @db.Text
  effectiveFrom DateTime              @map("effective_from") @db.Date
  effectiveUntil DateTime?            @map("effective_until") @db.Date
  changeSummary String?               @map("change_summary") @db.Text
  status        String                @default("EFFECTIVE") @db.VarChar(30)
  resolutionId  String?               @map("resolution_id") @db.Uuid
  documentId    String?               @map("document_id") @db.Uuid
  approvedById  String?               @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?             @map("approved_at") @db.Timestamptz(6)
  publishedAt   DateTime?             @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  policy        GovernancePolicy      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  resolution    GovernanceResolution? @relation(fields: [resolutionId], references: [id], onDelete: SetNull)
  document      Document?             @relation("PolicyDocument", fields: [documentId], references: [id], onDelete: SetNull)
  approvedBy    User?                 @relation("ApprovedPolicyVersions", fields: [approvedById], references: [id], onDelete: SetNull)

  acknowledgements PolicyAcknowledgement[]

  @@unique([policyId, versionNumber])
  @@index([policyId, effectiveFrom])
  @@map("governance_policy_versions")
}

model PolicyAcknowledgement {
  id              String                  @id @default(uuid()) @db.Uuid
  policyVersionId String                  @map("policy_version_id") @db.Uuid
  residentId      String                  @map("resident_id") @db.Uuid
  acknowledgedAt  DateTime                @default(now()) @map("acknowledged_at") @db.Timestamptz(6)

  policyVersion   GovernancePolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  resident        Resident                @relation("ResidentPolicyAcknowledgements", fields: [residentId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, residentId])
  @@map("governance_policy_acknowledgements")
}


