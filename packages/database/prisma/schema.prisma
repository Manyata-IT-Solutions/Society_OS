model BankStatement {
  id                 String              @id @default(uuid()) @db.Uuid
  bankAccountId      String              @map("bank_account_id") @db.Uuid
  statementReference String              @map("statement_reference") @db.VarChar(100)
  periodStart        DateTime            @map("period_start") @db.Date
  periodEnd          DateTime            @map("period_end") @db.Date
  openingBalance     Decimal             @map("opening_balance") @db.Decimal(14, 4)
  closingBalance     Decimal             @map("closing_balance") @db.Decimal(14, 4)
  currency           String              @default("INR") @db.VarChar(10)
  importSource       String              @default("CSV") @map("import_source") @db.VarChar(50)
  status             BankStatementStatus @default(UPLOADED)
  documentId         String?             @map("document_id") @db.Uuid
  importedAt         DateTime            @default(now()) @map("imported_at") @db.Timestamptz(6)
  createdById        String?             @map("created_by_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int                 @default(1)

  bankAccount        BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  document           Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)

