  organizationId     String                    @map("organization_id") @db.Uuid
  primaryCommunityId String?                   @map("primary_community_id") @db.Uuid
  workerNumber       String                    @unique @map("worker_number") @db.VarChar(50)
  workerType         String                    @default("EMPLOYEE") @map("worker_type") @db.VarChar(30)
  firstName          String                    @map("first_name") @db.VarChar(100)
  middleName         String?                   @map("middle_name") @db.VarChar(100)
  lastName           String                    @map("last_name") @db.VarChar(100)
  displayName        String                    @map("display_name") @db.VarChar(150)
  phone              String?                   @db.VarChar(30)
  email              String?                   @db.VarChar(255)
  dateOfBirth        DateTime?                 @map("date_of_birth") @db.Date
  gender             String?                   @db.VarChar(20)
  photoDocumentId    String?                   @map("photo_document_id") @db.Uuid
