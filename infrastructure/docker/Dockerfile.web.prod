# syntax=docker/dockerfile:1

# ==============================================================================
# Stage 1: Build Dependencies & Next.js Bundle (builder)
# ==============================================================================
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@10.34.4 --activate

WORKDIR /app

RUN apk add --no-cache libc6-compat

ENV NODE_OPTIONS="--max-old-space-size=4096"

# Build arguments for Next.js public environment variables
ARG NEXT_PUBLIC_API_URL="/api/v1"
ARG NEXT_PUBLIC_APP_NAME="Community OS"
ARG NEXT_PUBLIC_APP_VERSION="0.1.0"

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_APP_NAME=${NEXT_PUBLIC_APP_NAME}
ENV NEXT_PUBLIC_APP_VERSION=${NEXT_PUBLIC_APP_VERSION}

# Copy workspace configuration
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./

# Copy packages and web application
COPY packages/ ./packages/
COPY apps/admin-web/ ./apps/admin-web/

# Install all dependencies using frozen lockfile
RUN pnpm install --frozen-lockfile

# Compile shared workspace packages needed by admin-web
RUN pnpm --filter @community-os/types build
RUN pnpm --filter @community-os/validation build
RUN pnpm --filter @community-os/contracts build

# Build optimized Next.js app
RUN pnpm --filter @community-os/admin-web build

# ==============================================================================
# Stage 2: Lightweight Production Runtime (runner)
# ==============================================================================
FROM node:20-alpine AS runner

RUN corepack enable && corepack prepare pnpm@10.34.4 --activate

WORKDIR /app

RUN apk add --no-cache libc6-compat

ENV NODE_ENV=production
ENV PORT=3000

# Copy workspace configuration
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=builder /app/turbo.json ./turbo.json

# Copy installed dependencies and workspace packages
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages

# Copy Next.js production bundle & assets
COPY --from=builder /app/apps/admin-web/package.json ./apps/admin-web/package.json
COPY --from=builder /app/apps/admin-web/public ./apps/admin-web/public
COPY --from=builder /app/apps/admin-web/.next ./apps/admin-web/.next
COPY --from=builder /app/apps/admin-web/next.config.js ./apps/admin-web/next.config.js
COPY --from=builder /app/apps/admin-web/node_modules ./apps/admin-web/node_modules

# Assign ownership to non-root node user
RUN chown -R node:node /app

USER node

EXPOSE 3000

WORKDIR /app/apps/admin-web

CMD ["pnpm", "start"]

